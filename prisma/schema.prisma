// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id               Int        @id @default(autoincrement())
  name             String
  lastname         String
  dni              String?
  phone            String?
  email            String     @unique
  password         String?
  googleId         String?    @unique
  location         String?
  lat              Float?
  lng              Float?
  avatarUrl        String?     @db.MediumText
  purchaseStreak   Int        @default(80)
  isVerified       Boolean    @default(true)
  resetToken       String?    @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  orders           Order[]
}

model Product {
  id             Int            @id @default(autoincrement())
  name           String
  category       String
  subCategory    String?
  stock          Int            @default(20)
  price          Float
  unit           String
  description    String?        @db.VarChar(500)
  isRecommended  Boolean        @default(false)
  isBestSeller   Boolean        @default(false)
  imageKey       String
  createdAt      DateTime       @default(now())
  orderItems     OrderItem[]
  comboItems     ComboProduct[] @relation("ComboItems")
  comboParents   ComboProduct[] @relation("ComboParents")
}

model ComboProduct {
  id        Int     @id @default(autoincrement())
  comboId   Int
  productId Int
  quantity  Int     @default(1)
  combo     Product @relation("ComboItems", fields: [comboId], references: [id])
  product   Product @relation("ComboParents", fields: [productId], references: [id])

  @@unique([comboId, productId])
}

model Store {
  id              Int      @id @default(autoincrement())
  name            String
  category        String
  rating          Float
  deliveryTimeMin Int
  deliveryTimeMax Int
  distanceKm      Float
  lat             Float
  lng             Float
  address         String
  createdAt       DateTime @default(now())
}

model Order {
  id        String      @id @default(uuid())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  total     Float
  status    String
  address   String
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}
